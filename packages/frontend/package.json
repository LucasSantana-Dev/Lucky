{
    "name": "lucky-webapp",
    "private": true,
    "version": "2.17.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && tsx scripts/prerender-seo.ts",
        "preview": "vite preview",
        "lint": "eslint . --config eslint.config.js --max-warnings 0",
        "lint:fix": "eslint . --config eslint.config.js --max-warnings 0 --fix",
        "type:check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "check:deps": "tsx scripts/check-dependencies.ts",
        "check:deps:security": "DEPENDENCY_NOTIFY_ONLY_SECURITY=true tsx scripts/check-dependencies.ts",
        "check:deps:simple": "npx npm-check-updates",
        "check:outdated": "npm outdated"
    },
    "dependencies": {
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/manrope": "^5.3.0",
        "@fontsource/sora": "^5.3.0",
        "@hookform/resolvers": "^5.4.0",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-scroll-area": "^1.4.0",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-toast": "^1.3.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@sentry/react": "^11.7.0",
        "@tanstack/react-query": "^5.104.2",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^14.2.0",
        "i18next": "^26.4.5",
        "i18next-browser-languagedetector": "^8.2.1",
        "lucide-react": "^1.57.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.90.0",
        "react-i18next": "^17.0.16",
        "react-router-dom": "^7.18.4",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.7.0",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^4.6.7",
        "zustand": "^5.0.14"
    },
    "overrides": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@resvg/resvg-js": "^2.6.2",
        "@sentry/vite-plugin": "^5.4.1",
        "@size-limit/file": "^14.2.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.54.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.4",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "jsdom": "^30.1.2",
        "playwright": "^1.57.0",
        "postcss": "^8.5.23",
        "rollup-plugin-visualizer": "^7.0.1",
        "size-limit": "^14.1.0",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "undici": "^8.10.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
