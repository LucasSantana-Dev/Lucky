{
    "name": "lucky-webapp",
    "private": true,
    "version": "2.17.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && tsx scripts/prerender-seo.ts",
        "preview": "vite preview",
        "lint": "eslint . --config eslint.config.js --max-warnings 0",
        "lint:fix": "eslint . --config eslint.config.js --max-warnings 0 --fix",
        "type:check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "check:deps": "tsx scripts/check-dependencies.ts",
        "check:deps:security": "DEPENDENCY_NOTIFY_ONLY_SECURITY=true tsx scripts/check-dependencies.ts",
        "check:deps:simple": "npx npm-check-updates",
        "check:outdated": "npm outdated"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@radix-ui/react-avatar": "^1.2.5",
        "@radix-ui/react-checkbox": "^1.3.10",
        "@radix-ui/react-dialog": "^1.1.22",
        "@radix-ui/react-dropdown-menu": "^2.1.23",
        "@radix-ui/react-label": "^2.1.14",
        "@radix-ui/react-scroll-area": "^1.2.17",
        "@radix-ui/react-select": "^2.3.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.3.6",
        "@radix-ui/react-tabs": "^1.1.20",
        "@radix-ui/react-toast": "^1.2.22",
        "@radix-ui/react-tooltip": "^1.2.15",
        "@sentry/react": "^10.73.0",
        "@tanstack/react-query": "^5.102.8",
        "@vercel/analytics": "^2.0.1",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^13.1.1",
        "i18next": "^26.4.1",
        "i18next-browser-languagedetector": "^8.2.1",
        "lucide-react": "^1.39.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-hook-form": "^7.87.0",
        "react-i18next": "^17.0.13",
        "react-router-dom": "^7.18.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^4.5.4",
        "zustand": "^5.0.14"
    },
    "overrides": {
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.0",
        "@resvg/resvg-js": "^2.6.2",
        "@sentry/vite-plugin": "^5.4.0",
        "@size-limit/file": "^13.0.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.5",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "@typescript-eslint/parser": "^8.54.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.9.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.5",
        "jsdom": "^30.0.1",
        "playwright": "^1.57.0",
        "postcss": "^8.5.23",
        "rollup-plugin-visualizer": "^7.0.1",
        "size-limit": "^13.0.3",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "undici": "^8.10.1",
        "vite": "^8.2.2",
        "vitest": "^4.0.18"
    }
}
