# PoC gate image: runs the bench inside the target limits.
# docker build -f Dockerfile.poc -t lucky-render-poc .
# docker run --rm --cpus 0.25 --memory 128m lucky-render-poc
FROM rust:1-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --bin bench

FROM alpine:3
COPY --from=build /src/target/release/bench /usr/local/bin/bench
COPY fonts /fonts
COPY fixtures /fixtures
CMD ["bench", "/fixtures/recap-collage.json", "/fonts", "/tmp/recap.jpg", "200"]
