            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(lucky_backend_http_server_errors_total[5m])) / clamp_min(sum(rate(lucky_backend_http_requests_total[5m])), 1) or vector(0)",
