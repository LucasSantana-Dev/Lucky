        {
            "type": "stat",
            "title": "Alertas ativos",
            "description": "Quantos alertas estão disparados neste momento (sem contar o Watchdog, que fica sempre ligado de propósito). Normal: 0.",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "count(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"}) or vector(0)",
                    "instant": true,
                    "range": false
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
