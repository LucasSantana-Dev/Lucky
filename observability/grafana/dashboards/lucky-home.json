        {
            "type": "stat",
            "title": "Erros 5xx",
            "description": "Proporção de respostas de erro do backend nos últimos 5 minutos. Normal: 0%. Atenção: acima de 5% (dispara alerta).",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
