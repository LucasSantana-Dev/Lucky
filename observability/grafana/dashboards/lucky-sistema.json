        {
            "type": "timeseries",
            "title": "Tempo de resposta dos comandos (p50 e p95)",
            "description": "Do comando até a resposta, por dia. Poucas amostras por dia deixam a linha instável.",
            "gridPos": {
                "x": 0,
                "y": 5,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "${ds_postgres}"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "${ds_postgres}"
                    },
                    "rawSql": "SELECT date_trunc('day', \"occurredAt\") AS time, percentile_cont(0.5) WITHIN GROUP (ORDER BY \"latencyMs\") AS \"p50\", percentile_cont(0.95) WITHIN GROUP (ORDER BY \"latencyMs\") AS \"p95\" FROM command_events WHERE $__timeFilter(\"occurredAt\") GROUP BY 1 ORDER BY 1",
                    "format": "time_series",
                    "rawQuery": true,
                    "editorMode": "code",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineWidth": 2,
                        "showPoints": "always"
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "id": 8
        },
        {
            "type": "table",
            "title": "/play e outros comandos: tempo de resposta",
            "description": "",
            "gridPos": {
                "x": 12,
                "y": 5,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "${ds_postgres}"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "${ds_postgres}"
                    },
                    "rawSql": "SELECT command AS \"Comando\", count(*) AS \"Amostras\", round(percentile_cont(0.5) WITHIN GROUP (ORDER BY \"latencyMs\")) AS \"p50 (ms)\", round(percentile_cont(0.95) WITHIN GROUP (ORDER BY \"latencyMs\")) AS \"p95 (ms)\" FROM command_events WHERE $__timeFilter(\"occurredAt\") GROUP BY 1 ORDER BY 2 DESC LIMIT 12",
                    "format": "table",
                    "rawQuery": true,
                    "editorMode": "code",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {},
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": "p(50|95).*"
                        },
                        "properties": [
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-background"
                                }
                            },
                            {
                                "id": "thresholds",
                                "value": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "green",
                                            "value": null
                                        },
                                        {
                                            "color": "orange",
                                            "value": 3000
                                        },
                                        {
                                            "color": "red",
                                            "value": 8000
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            },
            "options": {},
            "id": 9
        },
        {
            "type": "timeseries",
            "title": "Backend: tempo de resposta (p50, p95, p99)",
            "description": "",
            "gridPos": {
