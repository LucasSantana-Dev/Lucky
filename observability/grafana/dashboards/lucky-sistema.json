    "panels": [
        {
            "type": "stat",
            "title": "Bot",
            "description": "",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "${ds_prometheus}"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${ds_prometheus}"
                    },
                    "expr": "max(up{job=\"lucky-bot\"})",
                    "legendFormat": "",
                    "instant": true,
                    "range": false,
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "FORA",
                                    "color": "red"
                                },
                                "1": {
                                    "text": "OK",
                                    "color": "green"
                                }
                            }
                        }
                    ]
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
