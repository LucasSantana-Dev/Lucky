                    "rawSql": "SELECT date_trunc('day', \"occurredAt\") AS time, count(*) FILTER (WHERE kind = 'JOIN') AS \"Entraram\", -count(*) FILTER (WHERE kind = 'LEAVE') AS \"Saíram\" FROM guild_membership_events WHERE $__timeFilter(\"occurredAt\") AND \"guildDiscordId\" NOT IN (SELECT unnest(string_to_array('$excluidas', ',')) UNION SELECT \"discordId\" FROM guilds WHERE name ILIKE '%test%' UNION SELECT \"guildDiscordId\" FROM guild_membership_events WHERE \"guildName\" ILIKE '%test%') GROUP BY 1 ORDER BY 1",
                    "format": "time_series",
                    "rawQuery": true,
                    "editorMode": "code",
