        {
            "type": "stat",
            "title": "WAG (7 dias)",
            "description": "Guildas com faixa tocada ou comando nos últimos 7 dias.",
            "gridPos": {
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 4
            },
            "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "${ds_postgres}"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "${ds_postgres}"
                    },
                    "rawSql": "SELECT count(DISTINCT g) AS \"Guildas ativas\" FROM (SELECT \"guildId\" AS g, \"playedAt\" AS t FROM track_history UNION ALL SELECT \"guildId\", \"occurredAt\" FROM command_events WHERE \"guildId\" IS NOT NULL) a WHERE t >= now() - interval '7 days' AND g NOT IN (SELECT unnest(string_to_array('$excluidas', ',')) UNION SELECT \"discordId\" FROM guilds WHERE name ILIKE '%test%' UNION SELECT \"guildDiscordId\" FROM guild_membership_events WHERE \"guildName\" ILIKE '%test%')",
                    "format": "table",
                    "rawQuery": true,
                    "editorMode": "code",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 10
                            },
                            {
                                "color": "green",
                                "value": 20
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto"
            },
            "id": 3
        },
        {
            "type": "stat",
            "title": "Ouviram música na 1ª hora",
            "description": "Guildas que entraram nos últimos 28 dias e tocaram uma faixa na primeira hora. Meta: 35%.",
            "gridPos": {
                "x": 4,
                "y": 4,
                "w": 5,
                "h": 4
            },
            "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "${ds_postgres}"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "${ds_postgres}"
                    },
                    "rawSql": "WITH joins AS (SELECT \"guildDiscordId\" AS g, min(\"occurredAt\") AS t FROM guild_membership_events WHERE kind = 'JOIN' GROUP BY 1 HAVING min(\"occurredAt\") > now() - interval '28 days'), c AS (SELECT j.t, EXISTS (SELECT 1 FROM track_history th WHERE th.\"guildId\" = j.g AND th.\"playedAt\" BETWEEN j.t AND j.t + interval '1 hour') AS heard, (EXISTS (SELECT 1 FROM track_history th WHERE th.\"guildId\" = j.g AND th.\"playedAt\" >= j.t + interval '7 days') OR EXISTS (SELECT 1 FROM command_events ce WHERE ce.\"guildId\" = j.g AND ce.\"occurredAt\" >= j.t + interval '7 days')) AS d8 FROM joins j WHERE j.g NOT IN (SELECT unnest(string_to_array('$excluidas', ',')) UNION SELECT \"discordId\" FROM guilds WHERE name ILIKE '%test%' UNION SELECT \"guildDiscordId\" FROM guild_membership_events WHERE \"guildName\" ILIKE '%test%')) SELECT round(100.0 * count(*) FILTER (WHERE t <= now() - interval '1 hour' AND heard) / nullif(count(*) FILTER (WHERE t <= now() - interval '1 hour'), 0), 1) AS \"1ª hora (%)\" FROM c",
                    "format": "table",
                    "rawQuery": true,
                    "editorMode": "code",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 25
                            },
                            {
                                "color": "green",
                                "value": 35
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    },
                    "noValue": "sem guildas novas"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto"
            },
            "id": 4
        },
