        {
            "type": "table",
            "title": "Tipos de falha mais comuns",
            "description": "Falhas de comando agrupadas pelo tipo do erro, no período. Comece pelo topo: o mesmo tipo repetido em vários comandos costuma ser uma causa só (ex.: banco ou Discord fora).",
            "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "lucky-analytics"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "lucky-analytics"
                    },
                    "rawQuery": true,
                    "editorMode": "code",
                    "format": "table",
                    "rawSql": "SELECT coalesce(classe_erro, 'desconhecido') AS \"Tipo de erro\", comando AS \"Comando\", sum(execucoes) AS \"Falhas\", to_char(max(dia), 'DD/MM/YYYY') AS \"Último dia\" FROM analytics.commands_daily WHERE resultado = 'error' AND $__timeFilter(inicio) AND ('${comando:raw}' = '.*' OR comando = '${comando:raw}') GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 25"
                }
            ],
            "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                    "show": false
                }
            },
            "fieldConfig": {
                "defaults": {
                    "noValue": "—"
                },
                "overrides": []
            },
