{
    "uid": "lucky-errors",
    "title": "Lucky: erros",
    "description": "Onde e por que o Lucky está falhando: comandos, API, música, card semanal e logs.",
    "editable": false,
    "schemaVersion": 39,
    "version": 1,
    "timezone": "browser",
    "weekStart": "monday",
    "time": {
        "from": "now-24h",
        "to": "now"
    },
    "refresh": "1m",
    "tags": ["lucky"],
    "links": [
        {
            "asDropdown": false,
            "icon": "external link",
            "includeVars": false,
            "keepTime": true,
            "tags": ["lucky"],
            "targetBlank": false,
            "title": "Dashboards do Lucky",
            "type": "dashboards"
        }
    ],
    "templating": {
        "list": [
            {
                "type": "query",
                "name": "comando",
                "label": "Comando",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "query": {
                    "query": "label_values(lucky_bot_commands_total, command)",
                    "refId": "PrometheusVariableQueryEditor-VariableQuery",
                    "qryType": 1
                },
                "refresh": 2,
                "sort": 1,
                "includeAll": true,
                "multi": false,
                "current": {
                    "selected": true,
                    "text": "Todos",
                    "value": "$__all"
                },
                "options": [],
                "hide": 0,
                "allValue": ".*"
            },
            {
                "type": "custom",
                "name": "nivel",
                "label": "Nível",
                "query": "ERROR,WARN",
                "includeAll": true,
                "multi": true,
                "allValue": "ERROR|WARN",
                "current": {
                    "selected": true,
                    "text": ["Todos"],
                    "value": ["$__all"]
                },
                "options": [],
                "hide": 0
            },
            {
                "type": "textbox",
                "name": "busca",
                "label": "Busca",
                "description": "Texto livre procurado na linha de log (sem diferenciar maiúsculas).",
                "query": "",
                "current": {
                    "text": "",
                    "value": ""
                },
                "hide": 0
            },
            {
                "type": "textbox",
                "name": "correlationId",
                "label": "Correlation ID",
                "description": "Código de correlação de uma requisição ou comando.",
                "query": "",
                "current": {
                    "text": "",
                    "value": ""
                },
                "hide": 0
            }
        ]
    },
    "panels": [
        {
            "type": "stat",
            "title": "Comandos que falharam",
            "description": "Comandos que terminaram em erro do bot (não conta erro do usuário, como argumento inválido) no período. Normal: perto de zero.",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(increase(lucky_bot_commands_total{outcome=\"error\",command=~\"$comando\"}[$__range])) or vector(0)",
                    "instant": true,
                    "range": false
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto",
                "justifyMode": "center",
                "orientation": "auto"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "noValue": "0",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 1
                            },
                            {
                                "color": "red",
                                "value": 20
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 0
                },
                "overrides": []
            },
            "id": 1,
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 0,
                "y": 0
            }
        },
        {
            "type": "stat",
            "title": "Taxa de falha dos comandos",
            "description": "% dos comandos que falharam no período. Normal: abaixo de 1%. Atenção: acima de 5%.",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(increase(lucky_bot_commands_total{outcome=\"error\",command=~\"$comando\"}[$__range])) / clamp_min(sum(increase(lucky_bot_commands_total{command=~\"$comando\"}[$__range])), 1) or vector(0)",
                    "instant": true,
                    "range": false
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
