                "orientation": "auto"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "noValue": "0",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 0.01
                            },
                            {
                                "color": "red",
                                "value": 0.05
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 1
