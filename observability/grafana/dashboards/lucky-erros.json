{
    "uid": "lucky-erros",
    "title": "Lucky: erros",
    "description": "O que deu errado, onde e quantas vezes. Logs do bot/backend/render (Loki), comandos (Postgres), HTTP (Prometheus) e Sentry.",
    "tags": ["lucky", "erros"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "schemaVersion": 39,
    "time": {
        "from": "now-7d",
        "to": "now"
    },
    "refresh": "5m",
    "templating": {
        "list": [
            {
                "name": "ds_prometheus",
                "type": "datasource",
                "query": "prometheus",
                "regex": "/^Prometheus$/",
                "hide": 2,
                "refresh": 1,
                "current": {},
                "options": [],
                "includeAll": false,
                "multi": false
            },
            {
                "name": "ds_loki",
                "type": "datasource",
                "query": "loki",
                "regex": "",
                "hide": 2,
                "refresh": 1,
                "current": {},
                "options": [],
                "includeAll": false,
                "multi": false
            },
            {
                "name": "ds_postgres",
                "type": "datasource",
                "query": "grafana-postgresql-datasource",
                "regex": "",
                "hide": 2,
                "refresh": 1,
                "current": {},
                "options": [],
                "includeAll": false,
                "multi": false
            },
            {
                "name": "ds_sentry",
                "type": "datasource",
                "query": "grafana-sentry-datasource",
                "regex": "",
                "hide": 2,
                "refresh": 1,
                "current": {},
                "options": [],
                "includeAll": false,
                "multi": false
            }
        ]
    },
    "annotations": {
        "list": []
    },
    "links": [
        {
            "type": "dashboards",
            "tags": ["lucky"],
            "asDropdown": false,
            "title": "Dashboards do Lucky",
            "includeVars": false,
            "keepTime": true,
            "targetBlank": false,
            "icon": "external link"
        }
    ],
    "panels": [
        {
            "type": "stat",
            "title": "Erros nos logs",
            "description": "Linhas [ERROR]/[FATAL] do bot, backend e render no período.",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 4
            },
            "datasource": {
                "type": "loki",
                "uid": "${ds_loki}"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "loki",
                        "uid": "${ds_loki}"
                    },
                    "expr": "sum(count_over_time({container_name=~\"lucky-(bot|backend|render)\"} |~ `^\\[(ERROR|FATAL|CRITICAL)\\]` [$__range])) or vector(0)",
                    "legendFormat": "",
                    "queryType": "instant",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 1
                            },
                            {
                                "color": "red",
                                "value": 20
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto"
            },
            "id": 1
        },
        {
            "type": "stat",
            "title": "Comandos com erro",
            "description": "Comandos que terminaram em erro. Otimista: comando que trata o erro e responde sozinho conta como ok.",
            "gridPos": {
                "x": 4,
                "y": 0,
                "w": 4,
                "h": 4
            },
            "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "${ds_postgres}"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "${ds_postgres}"
                    },
                    "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE outcome = 'error') / nullif(count(*), 0), 1) AS \"Erro (%)\" FROM command_events WHERE $__timeFilter(\"occurredAt\")",
                    "format": "table",
                    "rawQuery": true,
                    "editorMode": "code",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 2
                            },
                            {
                                "color": "red",
                                "value": 5
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto"
            },
            "id": 2
        },
