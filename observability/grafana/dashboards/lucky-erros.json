        {
            "type": "table",
            "title": "Comandos que não deram certo",
            "description": "user_error = uso errado; denied = sem permissão; error = falha do bot.",
            "gridPos": {
                "x": 0,
                "y": 22,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "${ds_postgres}"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "${ds_postgres}"
                    },
                    "rawSql": "SELECT command AS \"Comando\", outcome AS \"Resultado\", coalesce(\"errorClass\", '') AS \"Erro\", count(*) AS \"Vezes\", max(\"occurredAt\") AS \"Última vez\" FROM command_events WHERE outcome <> 'ok' AND $__timeFilter(\"occurredAt\") GROUP BY 1, 2, 3 ORDER BY 4 DESC LIMIT 20",
                    "format": "table",
                    "rawQuery": true,
                    "editorMode": "code",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "noValue": "Nenhum comando com erro no período"
                },
                "overrides": []
            },
            "options": {},
            "id": 11
        },
