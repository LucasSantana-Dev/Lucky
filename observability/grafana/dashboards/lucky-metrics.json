{
    "uid": "lucky-metrics",
    "title": "Lucky: métricas",
    "description": "Desempenho do Lucky: ritmo e tempo de resposta dos comandos, API, render e processos.",
    "editable": false,
    "schemaVersion": 39,
    "version": 1,
    "timezone": "browser",
    "weekStart": "monday",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "refresh": "30s",
    "tags": ["lucky"],
    "links": [
        {
            "asDropdown": false,
            "icon": "external link",
            "includeVars": false,
            "keepTime": true,
            "tags": ["lucky"],
            "targetBlank": false,
            "title": "Dashboards do Lucky",
            "type": "dashboards"
        }
    ],
    "templating": {
        "list": [
            {
                "type": "query",
                "name": "comando",
                "label": "Comando",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "query": {
                    "query": "label_values(lucky_bot_commands_total, command)",
                    "refId": "PrometheusVariableQueryEditor-VariableQuery",
                    "qryType": 1
                },
                "refresh": 2,
                "sort": 1,
                "includeAll": true,
                "multi": false,
                "current": {
                    "selected": true,
                    "text": "Todos",
                    "value": "$__all"
                },
                "options": [],
                "hide": 0,
                "allValue": ".*"
            },
            {
                "type": "query",
                "name": "rota",
                "label": "Rota da API",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "query": {
                    "query": "label_values(lucky_backend_http_requests_total, route)",
                    "refId": "PrometheusVariableQueryEditor-VariableQuery",
                    "qryType": 1
                },
                "refresh": 2,
                "sort": 1,
                "includeAll": true,
                "multi": false,
                "current": {
                    "selected": true,
                    "text": "Todos",
                    "value": "$__all"
                },
                "options": [],
                "hide": 0,
                "allValue": ".*"
            }
        ]
    },
    "panels": [
        {
            "type": "stat",
            "title": "Comandos por minuto agora",
            "description": "Média de comandos por minuto nos últimos 5 minutos.",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(lucky_bot_commands_total{command=~\"$comando\"}[5m])) * 60 or vector(0)",
                    "instant": true,
                    "range": false
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto",
                "justifyMode": "center",
                "orientation": "auto"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "noValue": "0",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 1
                },
                "overrides": []
            },
            "id": 1,
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 0
            }
        },
        {
            "type": "stat",
            "title": "Tempo dos comandos (p95) agora",
            "description": "95% dos comandos dos últimos 5 minutos responderam em até este tempo. Normal: abaixo de 2 s. Atenção: acima de 5 s (o Discord mostra \"pensando\").",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(lucky_bot_command_duration_seconds_bucket{command=~\"$comando\"}[5m])))",
                    "instant": true,
                    "range": false
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
